<?xml version="1.0"?>
<DTS:Executable xmlns:DTS="www.microsoft.com/SqlServer/Dts"
  DTS:refId="Package"
  DTS:CreationName="Microsoft.Package"
  DTS:DTSID="{6A1F0E00-0000-4000-800B-000000000001}"
  DTS:ExecutableType="Microsoft.Package"
  DTS:ObjectName="write_audit">
  <DTS:Property
    DTS:Name="PackageFormatVersion">8</DTS:Property>
  <DTS:ConnectionManagers>
    <DTS:ConnectionManager
      DTS:refId="Package.ConnectionManagers[demo_db]"
      DTS:CreationName="OLEDB"
      DTS:DTSID="{6A1F0E00-0000-4000-800B-0000000000C1}"
      DTS:ObjectName="demo_db">
      <DTS:ObjectData>
        <DTS:ConnectionManager
          DTS:ConnectionString="Data Source=server_a;Initial Catalog=demo_db;Provider=SQLNCLI11.1;Integrated Security=SSPI;" />
      </DTS:ObjectData>
    </DTS:ConnectionManager>
  </DTS:ConnectionManagers>
  <DTS:Variables>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{6A1F0E00-0000-4000-800B-0000000000A1}"
      DTS:IncludeInDebugDump="6789"
      DTS:Namespace="User"
      DTS:ObjectName="loaded_rows">
      <DTS:VariableValue
        DTS:DataType="3">0</DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Count rows"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{6A1F0E00-0000-4000-800B-0000000000E1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:ObjectName="Count rows">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{6A1F0E00-0000-4000-800B-0000000000C1}"
          SQLTask:SqlStatementSource="SELECT COUNT(*) AS loaded FROM demo.stage"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::loaded_rows" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Write audit"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{6A1F0E00-0000-4000-800B-0000000000E2}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:ObjectName="Write audit">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{6A1F0E00-0000-4000-800B-0000000000C1}"
          SQLTask:SqlStatementSource="INSERT INTO demo.audit (row_total)&#xA;VALUES (?);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::loaded_rows"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
  <DTS:PrecedenceConstraints>
    <DTS:PrecedenceConstraint
      DTS:refId="Package.PrecedenceConstraints[Constraint]"
      DTS:CreationName=""
      DTS:DTSID="{6A1F0E00-0000-4000-800B-0000000000B1}"
      DTS:EvalOp="3"
      DTS:Expression="@[User::loaded_rows] &gt; 0"
      DTS:From="Package\Count rows"
      DTS:LogicalAnd="True"
      DTS:ObjectName="Constraint"
      DTS:To="Package\Write audit" />
  </DTS:PrecedenceConstraints>
